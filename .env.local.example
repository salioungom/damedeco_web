# 📋 Fichier d'environnement Next.js 16
# Placez ce fichier à la racine du projet (même niveau que package.json)
# Redémarrez le serveur de développement après toute modification

# 🔥 URL de l'API backend (OBLIGATOIRE)
# Format: http://localhost:8000 ou https://votre-domaine.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# 🌍 URL canonique du frontend (locale en développement)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 🔧 URL de l'API pour le rendu serveur (SSR/ISR) — OPTIONNEL
# Utile dans Docker où "localhost" pointe vers le conteneur, pas l'hôte.
# Local Docker: http://host.docker.internal:8000
# Production:   même valeur que NEXT_PUBLIC_API_URL (ou URL interne du backend)
# API_URL_SERVER=http://host.docker.internal:8000

# 🌍 Environnement (développement/production)
NODE_ENV=development

# 🔐 Clés JWT (générées par le backend)
# NEXT_PUBLIC_JWT_SECRET=your-secret-key-here
# NEXT_PUBLIC_JWT_REFRESH_SECRET=your-refresh-secret-here

# 📧 Configuration du debug (développement uniquement)
NEXT_PUBLIC_DEBUG_MODE=true

# 🌐 Configuration CORS (si nécessaire)
# NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000,https://votre-domaine.com

# 📱 Configuration de l'application
NEXT_PUBLIC_APP_NAME=DameDéco
NEXT_PUBLIC_APP_VERSION=2.0.0

# 📧 Notes importantes:
# 1. Toutes les variables NEXT_PUBLIC_* sont accessibles côté client
# 2. Les variables sans NEXT_PUBLIC_ sont uniquement côté serveur
# 3. Après modification de ce fichier, redémarrez avec: npm run dev
# 4. En production, utilisez des variables d'environnement réelles
# 5. Ne jamais commit de mots de passe ou clés secrètes

# 🚨 Sécurité:
# - Ne jamais utiliser de clés par défaut en production
# - Changez régulièrement les clés JWT
# - Utilisez HTTPS en production
# - Limitez les origines autorisées

# 📝 En production, définissez ces variables dans l'hébergeur ou GitHub Actions:
# NEXT_PUBLIC_API_URL=<URL publique de l'API>
# NEXT_PUBLIC_SITE_URL=<URL publique du frontend>
# API_URL_SERVER=<URL de l'API accessible par le serveur, si différente>
# NODE_ENV=production
# NEXT_PUBLIC_DEBUG_MODE=false
