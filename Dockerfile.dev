# Dockerfile.dev - Build pour développement (hot reload)
FROM node:22-alpine

# Installer curl pour les healthchecks
RUN apk add --no-cache curl

# Activer pnpm avec la version exacte détectée
RUN corepack enable && corepack prepare pnpm@11.1.2 --activate

WORKDIR /app

# Copier package.json, pnpm-lock.yaml et pnpm-workspace.yaml pour profiter du cache Docker
# pnpm-workspace.yaml est nécessaire pour allowBuilds (dépendances natives)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Installer les dépendances avec le lockfile figé
RUN pnpm install --frozen-lockfile

# Copier le reste du code source
COPY . .

# Exposer le port 3000
EXPOSE 3000

# Démarrer en mode dev sur toutes les interfaces
CMD ["pnpm", "run", "dev", "--hostname", "0.0.0.0", "--port", "3000"]
